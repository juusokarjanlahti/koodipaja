# Copy to .env (used by docker compose) and app/.env.local (used by the app).

# --- App database (docker compose service "db") ---
POSTGRES_DB=koodipaja
POSTGRES_USER=koodipaja
POSTGRES_PASSWORD=change-me-db
DATABASE_URL=postgres://koodipaja:change-me-db@127.0.0.1:5432/koodipaja

# --- Queue ---
REDIS_URL=redis://127.0.0.1:6379

# --- Code runner (ADR 0006): go-judge (default) or judge0 (legacy) ---
RUNNER=go-judge
GO_JUDGE_URL=http://127.0.0.1:5050
GO_JUDGE_AUTH_TOKEN=change-me-go-judge-token
# PATH and TypeScript type roots inside the sandbox. Defaults match the Docker image;
# infra/go-judge/dev.sh --print-env prints the values for a local sandbox.
GO_JUDGE_PATH=/usr/local/bin:/usr/bin:/bin
GO_JUDGE_TS_TYPE_ROOTS=/usr/local/lib/node_modules/@types

# --- Legacy Judge0, only with RUNNER=judge0 (must match infra/judge0.conf) ---
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=change-me-judge0-token

# --- Sessions ---
# Public URL of the app (LTI redirect URIs and redirects after a Moodle launch).
APP_URL=http://localhost:3000
# Tool key for LTI 1.3 (Moodle). Generate with: cd app && npm run lti:keygen
LTI_PRIVATE_KEY=
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-hex-chars
# Development-only email login. Never enable in production.
DEV_LOGIN=true
