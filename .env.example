# Copy to .env (used by docker compose) and app/.env.local (used by the app).

# --- App database (docker compose service "db") ---
POSTGRES_DB=koodipaja
POSTGRES_USER=koodipaja
POSTGRES_PASSWORD=change-me-db
DATABASE_URL=postgres://koodipaja:change-me-db@127.0.0.1:5432/koodipaja

# --- Queue ---
REDIS_URL=redis://127.0.0.1:6379

# --- Judge0 (must match infra/judge0.conf) ---
JUDGE0_URL=http://127.0.0.1:2358
JUDGE0_AUTH_HEADER=X-Auth-Token
JUDGE0_AUTH_TOKEN=change-me-judge0-token

# --- Sessions ---
# Generate with: openssl rand -hex 32
SESSION_SECRET=change-me-to-64-hex-chars
# Development-only email login. Never enable in production.
DEV_LOGIN=true
